<script>
    // Re-run the draw animation for the arrow pack on demand.
    function initReplay() {
        const button = document.getElementById('replay-arrows');
        const pack = document.getElementById('arrow-pack');
        if (!button || !pack) return;

        button.addEventListener('click', () => {
            const glyphs = pack.querySelectorAll<SVGElement>('[data-draw]');
            glyphs.forEach((el) => el.classList.remove('is-drawn'));
            // Force a reflow so the animation restarts rather than being ignored.
            void (pack as HTMLElement).offsetWidth;
            glyphs.forEach((el) => el.classList.add('is-drawn'));
        });
    }

    initReplay();
    document.addEventListener('astro:after-swap', initReplay);
</script>
