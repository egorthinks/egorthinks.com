---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FaqSection from '../../components/FaqSection.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostPreview from '../../components/PostPreview.astro';
import Subscribe from '../../components/Subscribe.astro';
import siteConfig from '../../data/site-config';
import { slugify } from '../../utils/common-utils';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import { formatReadingTime, getReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    const postCount = posts.length;
    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null
        }
    }));
}

type Props = { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'>; nextPost: CollectionEntry<'blog'> };

const { href } = Astro.url;
const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags, faq, seo } = post.data;
const { Content } = await render(post);
const readingTimeMinutes = getReadingTime(post.body ?? '');
// Only an image the post chose for itself. Without one, BaseHead points at the
// card generated at build time - the old `/og/{id}.png` convention silently
// shipped a broken preview for any post nobody had hand-made a file for.
const ogImage = seo?.image;
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt ?? siteConfig.description} image={ogImage} pageType="article" publishDate={publishDate} updatedDate={updatedDate} faq={faq} showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
            <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-main/70">
                <FormattedDate date={publishDate} />
                <span aria-hidden="true">·</span>
                <span>{formatReadingTime(readingTimeMinutes)}</span>
                {
                    updatedDate && (
                        <>
                            <span aria-hidden="true">·</span>
                            <span>
                                Updated <FormattedDate date={updatedDate} />
                            </span>
                        </>
                    )
                }
                <span aria-hidden="true">·</span>
                <button
                    type="button"
                    class="copy-url-button text-main/70 underline decoration-1 decoration-dashed underline-offset-2 transition-colors hover:text-main hover:decoration-solid"
                    aria-label="Copy link"
                    data-url={href}
                    data-tooltip-default="Copy link"
                    data-tooltip-success="Copied"
                >
                    Share
                </button>
            </div>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
        {faq && <FaqSection faq={faq} />}
        {
            tags.length > 0 && (
                <div class="mt-8 flex flex-wrap gap-2 text-sm sm:mt-12">
                    {tags.map((tag) => (
                        <a class="bg-muted rounded-full px-3 py-1 hover:underline hover:underline-offset-2" href={`/tags/${slugify(tag)}/`}>
                            #{tag}
                        </a>
                    ))}
                </div>
            )
        }
        <div class="mt-8 flex flex-wrap items-center justify-end gap-6 text-sm sm:mt-12 sm:text-base">
            <Button class="copy-url-button" aria-label="Copy link" data-url={href} data-tooltip-default="Copy link" data-tooltip-success="Copied">Share</Button>
        </div>
    </article>
    {
        (prevPost || nextPost) && (
            <div class="my-16 sm:my-24">
                <h2 class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">Read Next</h2>
                {nextPost && <PostPreview post={nextPost} class="mb-10 sm:mb-12" headingLevel="h3" />}
                {prevPost && <PostPreview post={prevPost} class="mb-10 sm:mb-12" headingLevel="h3" />}
            </div>
        )
    }
    <Subscribe class="my-16 sm:my-24" />
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const copyUrlButtons = document.querySelectorAll<HTMLElement>('.copy-url-button');
        copyUrlButtons.forEach((button) => {
            button.addEventListener('click', async () => {
                await copyUrl(button);
            });
        });

        async function copyUrl(button: HTMLElement) {
            const url = button.getAttribute('data-url') || '';
            const label = button.innerText;

            await navigator.clipboard.writeText(url);

            button.innerText = 'Copied';

            setTimeout(() => {
                button.innerText = label;
            }, 2500);
        }
    });
</script>
