# Copy to .env for `npm run dev`. Production values go in the Vercel project settings.

# Local development: keep the encrypted data in ./.vault-data instead of GitHub.
VAULT_STORAGE=fs

# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VAULT_SESSION_SECRET=
VAULT_SETUP_TOKEN=
# Lets you call /api/cron/expire-chats by hand: curl -H "Authorization: Bearer $CRON_SECRET" ...
CRON_SECRET=

# Production (or to develop against a real repository):
# VAULT_ORIGIN=https://vault.egorthinks.com
# VAULT_GITHUB_REPO=egorthinks/vault-data
# VAULT_GITHUB_TOKEN=
# VAULT_GITHUB_BRANCH=main
# Chat keys (added by Vercel when a Blob store is connected; VAULT_STORAGE=fs keeps them in .vault-data instead):
# BLOB_READ_WRITE_TOKEN=
